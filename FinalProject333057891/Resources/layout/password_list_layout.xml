<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

	<LinearLayout
        android:id="@+id/llHeader"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

		<!-- Title -->
		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passwords"
            android:textColor="@color/textPrimary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp" />

		<Button
            android:id="@+id/btnAddPasswordToList"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="New Password"
            android:textSize="18sp"
            android:textColor="@color/buttonText"
            android:background="@color/colorPrimaryDark"
            android:textAllCaps="false"/>

	</LinearLayout>

	<!-- RecyclerView for password list -->
	<androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPasswordList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llHeader"
        android:layout_above="@id/flPasswordListMenuContainer"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

	<!-- Empty state message (shown when no passwords) -->
	<TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No passwords saved yet.\nTap 'New Password' to add one."
        android:textColor="@color/textPrimary"
        android:textSize="16sp"
        android:textAlignment="center"
        android:visibility="gone" />

	<!-- Menu fragment container -->
	<FrameLayout
        android:id="@+id/flPasswordListMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>