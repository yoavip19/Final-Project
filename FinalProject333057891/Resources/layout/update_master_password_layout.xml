<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

	<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/colorPrimaryDark">
		<!-- Title -->
		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Update Master Password"
			android:textColor="@color/textPrimary"
			android:textSize="34sp"
			android:textStyle="bold"
			android:paddingHorizontal="32dp"
			android:paddingVertical="12dp"
			android:elevation="6dp"/>

		<!-- Password -->
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:text="Password"
			android:textSize="16sp"
			android:textColor="@color/textPrimary"/>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="48dp"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:layout_marginTop="4dp">

			<EditText
				android:id="@+id/etUpdateMasterPassword"
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="match_parent"
				android:padding="12dp"
				android:textSize="16sp"
				android:background="@drawable/edittext_bg"
				android:hint="Enter password"
				android:textColor="@color/textPrimary"
				android:textColorHint="@color/hintText"
				android:inputType="textPassword"/>

			<Button
				android:id="@+id/btnUpdateMasterHidePassword"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_marginStart="8dp"
				android:background="@drawable/design_password_eye"/>
		</LinearLayout>

		<TextView
			android:id="@+id/tvUpdateMasterPasswordError"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="* Weak password"
			android:textColor="@color/errorColor"
			android:visibility="gone"
			android:textSize="14sp"
			android:paddingTop="4dp"/>

		<!-- Confirm Password -->
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:text="Confirm Password"
			android:textSize="16sp"
			android:textColor="@color/textPrimary"/>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="48dp"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:layout_marginTop="4dp">

			<EditText
				android:id="@+id/etUpdateMasterConfirmPassword"
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="match_parent"
				android:padding="12dp"
				android:textSize="16sp"
				android:background="@drawable/edittext_bg"
				android:hint="Enter password"
				android:textColor="@color/textPrimary"
				android:textColorHint="@color/hintText"
				android:inputType="textPassword"/>

			<Button
				android:id="@+id/btnUpdateMasterHideConfirmPassword"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_marginStart="8dp"
				android:background="@drawable/design_password_eye"/>
		</LinearLayout>

		<TextView
			android:id="@+id/tvUpdateMasterConfirmPasswordError"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="* Weak password"
			android:textColor="@color/errorColor"
			android:visibility="gone"
			android:textSize="14sp"
			android:paddingTop="4dp"/>

		<!-- Update Button -->
		<Button
			android:id="@+id/btnUpdateMasterPassword"
			android:layout_width="200dp"
			android:layout_height="56dp"
			android:layout_marginTop="32dp"
			android:layout_gravity="center"
			android:textSize="18sp"
			android:text="Update!"
			android:textColor="@color/buttonText"
			android:background="@color/colorPrimaryDark"
			android:textAllCaps="false"/>
	</LinearLayout>


	<!-- Fixed bottom menu fragment -->
	<FrameLayout
        android:id="@+id/flUpdateMasterPasswordMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>