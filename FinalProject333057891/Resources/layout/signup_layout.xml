<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

	<!-- Scrollable content -->
	<ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@id/flSignupMenuContainer">

	    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

		    <!-- Title -->
		    <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textColor="@color/textPrimary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:layout_marginTop="40dp"
                android:padding="12dp" />

		    <!-- Username -->
		    <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Username"
                android:textSize="16sp"
                android:textColor="@color/textPrimary"/>

		    <EditText
                android:id="@+id/etSignupUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="12dp"
                android:textSize="16sp"
                android:background="@drawable/edittext_bg"
                android:hint="Enter username"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/hintText"
                android:inputType="textPersonName"/>

		    <TextView
                android:id="@+id/tvSignupUsernameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/errorColor"
                android:text="* Invalid username"
                android:visibility="gone"
                android:textSize="14sp"
                android:paddingTop="4dp"/>

		    <!-- Email -->
		    <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Email"
                android:textSize="16sp"
                android:textColor="@color/textPrimary"/>

		    <EditText
                android:id="@+id/etSignupEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="12dp"
                android:textSize="16sp"
                android:background="@drawable/edittext_bg"
                android:hint="Enter email"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/hintText"
                android:inputType="textEmailAddress"/>

		    <TextView
                android:id="@+id/tvSignupEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/errorColor"
                android:text="* Invalid email"
                android:visibility="gone"
                android:textSize="14sp"
                android:paddingTop="4dp"/>

		    <!-- Phone -->
		    <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Phone"
                android:textSize="16sp"
                android:textColor="@color/textPrimary"/>

		    <EditText
                android:id="@+id/etSignupPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="12dp"
                android:textSize="16sp"
                android:background="@drawable/edittext_bg"
                android:hint="Enter phone"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/hintText"
                android:inputType="number"/>

		    <TextView
                android:id="@+id/tvSignupPhoneError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/errorColor"
                android:text="* Invalid phone"
                android:visibility="gone"
                android:textSize="14sp"
                android:paddingTop="4dp"/>

		    <!-- Password -->
		    <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Password"
                android:textSize="16sp"
                android:textColor="@color/textPrimary"/>

		    <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

			    <EditText
                    android:id="@+id/etSignupPassword"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Enter password"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/hintText"
                    android:inputType="textPassword"/>

			    <Button
                    android:id="@+id/btnSignupHidePassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/design_password_eye"/>
		    </LinearLayout>

		    <TextView
                android:id="@+id/tvSignupPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* Weak password"
                android:textColor="@color/errorColor"
                android:visibility="gone"
                android:textSize="14sp"
                android:paddingTop="4dp"/>

		    <!-- Confirm Password -->
		    <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Confirm Password"
                android:textSize="16sp"
                android:textColor="@color/textPrimary"/>

		    <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

			    <EditText
                    android:id="@+id/etSignupConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:background="@drawable/edittext_bg"
                    android:hint="Enter password"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/hintText"
                    android:inputType="textPassword"/>

			    <Button
                    android:id="@+id/btnSignupHideConfirmPassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/design_password_eye"/>
		    </LinearLayout>

		    <TextView
                android:id="@+id/tvSignupConfirmPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* Weak password"
                android:textColor="@color/errorColor"
                android:visibility="gone"
                android:textSize="14sp"
                android:paddingTop="4dp"/>

		    <!-- Sign Up Button -->
		    <Button
                android:id="@+id/btnSignupSubmit"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Sign Up"
                android:textSize="18sp"
                android:textColor="@color/buttonText"
                android:background="@color/colorPrimaryDark"
                android:textAllCaps="false"/>

	    </LinearLayout>
    </ScrollView>

	<!-- Fixed bottom menu fragment -->
	<FrameLayout
        android:id="@+id/flSignupMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>