<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@color/colorPrimary">

	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

		<!-- Title -->
		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Password"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="24dp" />

		<!-- App Info Display -->
		<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/colorPrimaryDark"
            android:layout_marginBottom="24dp">

			<ImageView
                android:id="@+id/ivViewAppIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:contentDescription="App icon" />

			<TextView
                android:id="@+id/tvViewAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="App Name"
                android:textSize="18sp"
                android:textColor="@color/textPrimary"
                android:textStyle="bold" />

		</LinearLayout>

		<!-- Username Display -->
		<TextView
            android:id="@+id/tvViewAppUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username: username@example.com"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="24dp" />

		<!-- Password Section -->
		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

		<!-- Password Display with Show/Hide Button -->
		<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/colorPrimaryDark"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

			<TextView
                android:id="@+id/tvViewPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="••••••••"
                android:textSize="18sp"
                android:textColor="@color/textPrimary"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

			<Button
                android:id="@+id/btnTogglePasswordVisibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show"
                android:textSize="14sp"
                android:textColor="@color/buttonText"
                android:background="@color/colorPrimaryDark"
                android:minWidth="60dp"
                android:enabled="false" />

		</LinearLayout>

		<!-- Copy Button -->
		<Button
            android:id="@+id/btnCopyPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Copy to Clipboard"
            android:textSize="18sp"
            android:textColor="@color/buttonText"
            android:background="@color/colorPrimaryDark"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp"
            android:enabled="false" />

		<!-- Security Warning (Initially Hidden) -->
		<LinearLayout
            android:id="@+id/tvSecurityWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFEBEE"
            android:padding="12dp"
            android:visibility="gone">

			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Security Reminder"
                android:textSize="16sp"
                android:textColor="#C62828"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your password is now in your clipboard. Please paste it where needed and clear your clipboard history immediately after use to maintain security."
                android:textSize="14sp"
                android:textColor="#C62828" />

		</LinearLayout>

	</LinearLayout>

</ScrollView>
