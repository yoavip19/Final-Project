<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@color/colorPrimary">

	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

		<!-- Title -->
		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Password"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="16dp" />

		<!-- Selected App Display (Read-only) -->
		<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/colorPrimaryDark"
            android:layout_marginBottom="16dp">

			<ImageView
                android:id="@+id/ivEditAppIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop" />

			<TextView
                android:id="@+id/tvEditAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="App Name"
                android:textSize="18sp"
                android:textColor="@color/textPrimary"
                android:textStyle="bold" />

		</LinearLayout>

		<!-- App Username -->
		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username / Email"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

		<EditText
            android:id="@+id/etEditAppUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Enter username or email"
            android:inputType="textEmailAddress"
            android:background="@color/colorPrimaryDark"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:padding="12dp" />

		<TextView
            android:id="@+id/tvEditAppUsernameError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Error message"
            android:textColor="@color/errorColor"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="4dp" />

		<!-- New Password -->
		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Password"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

		<RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

			<EditText
                android:id="@+id/etEditPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter new password"
                android:inputType="textPassword"
                android:background="@color/colorPrimaryDark"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:padding="12dp"
                android:paddingEnd="50dp" />

			<Button
                android:id="@+id/btnEditTogglePassword"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:text="👁"
                android:textSize="16sp"
                android:background="?android:attr/selectableItemBackground" />

		</RelativeLayout>

		<TextView
            android:id="@+id/tvEditPasswordError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Error message"
            android:textColor="@color/errorColor"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="4dp" />

		<!-- Confirm New Password -->
		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Confirm New Password"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

		<RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

			<EditText
                android:id="@+id/etEditConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Confirm new password"
                android:inputType="textPassword"
                android:background="@color/colorPrimaryDark"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:padding="12dp"
                android:paddingEnd="50dp" />

			<Button
                android:id="@+id/btnEditToggleConfirmPassword"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:text="👁"
                android:textSize="16sp"
                android:background="?android:attr/selectableItemBackground" />

		</RelativeLayout>

		<TextView
            android:id="@+id/tvEditConfirmPasswordError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Error message"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="4dp" />

		<!-- Favorite Checkbox -->
		<CheckBox
            android:id="@+id/cbEditFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark as Favorite"
            android:textColor="@color/textPrimary"
            android:layout_marginTop="16dp" />

		<!-- Save Changes Button -->
		<Button
            android:id="@+id/btnSavePasswordChanges"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Changes"
            android:textSize="18sp"
            android:textColor="@color/buttonText"
            android:background="@color/colorPrimaryDark"
            android:textAllCaps="false"
            android:layout_marginTop="24dp" />

	</LinearLayout>

</ScrollView>
