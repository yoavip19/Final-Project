<resources>
	<style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
		<item name="colorPrimary">@color/colorPrimary</item>
		<item name="colorPrimaryDark">@color/colorPrimaryDark</item>
		<item name="colorAccent">@color/colorAccent</item>
		<item name="android:textColorPrimary">@color/textPrimary</item>
		<item name="android:textColorSecondary">@color/textSecondary</item>
		<item name="android:buttonStyle">@style/GreenButton</item>
		<item name="android:editTextBackground">@drawable/edittext_bg</item>
	</style>

	<!-- Buttons -->
	<style name="GreenButton" parent="Widget.MaterialComponents.Button">
		<item name="android:backgroundTint">@color/colorPrimary</item>
		<item name="android:textColor">@color/buttonText</item>
		<item name="android:paddingHorizontal">16dp</item>
		<item name="android:paddingVertical">10dp</item>
		<item name="android:textAllCaps">false</item>
		<item name="cornerRadius">12dp</item>
	</style>
</resources>
