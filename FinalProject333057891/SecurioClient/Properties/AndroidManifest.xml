<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          android:versionCode="1" 
          android:versionName="1.0" 
          package="com.companyname.securioclient">
  <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />
  <application android:usesCleartextTraffic="true" android:label="Securio" android:allowBackup="true" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/AppTheme">
    <!-- Disable WorkManager's automatic initialization so that SecurioClientApplication
         can call WorkManager.Initialize() with our custom WorkerFactory.
         Without this, the default ContentProvider auto-initializes WorkManager before
         Application.OnCreate() runs, causing a duplicate-initialization exception. -->
    <provider
        android:name="androidx.startup.InitializationProvider"
        android:authorities="com.companyname.securioclient.androidx-startup"
        android:exported="false"
        tools:node="merge">
      <meta-data
          android:name="androidx.work.WorkManagerInitializer"
          android:value="androidx.startup"
          tools:node="remove" />
    </provider>
  </application>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
