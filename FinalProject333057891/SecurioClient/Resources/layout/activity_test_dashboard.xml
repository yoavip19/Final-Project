<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧪 Test Dashboard"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Testing branch — not for production"
            android:textSize="12sp"
            android:textColor="#F44336"
            android:layout_marginBottom="20dp" />

        <!-- ── Service status ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SERVICE STATUS"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textViewServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking…"
            android:textSize="15sp"
            android:textColor="#212121"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textViewIntervalInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#757575"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- ── Last check result ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAST CHECK RESULT"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textViewLastResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No result yet — press Run Check to trigger the first cycle."
            android:textSize="14sp"
            android:textColor="#212121"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- ── Manual triggers ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MANUAL TRIGGERS"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/buttonRunCheckNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Run Password Check Now"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/buttonSimulateBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Simulate BOOT_COMPLETED"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/buttonSimulateUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Simulate MY_PACKAGE_REPLACED"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- ── ADB hints ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADB VERIFICATION COMMANDS"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service running:\nadb shell dumpsys activity services | grep PasswordMonitor\n\nFilter test logs:\nadb logcat -s SecurioTest\n\nSend boot broadcast:\nadb shell am broadcast -a android.intent.action.BOOT_COMPLETED"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#37474F"
            android:background="#ECEFF1"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressBarTestDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
